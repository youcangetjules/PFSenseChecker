#!/bin/sh
# Copy the tracked pre-commit hook into .git/hooks. Does not change git config.
root=$(git rev-parse --show-toplevel) || exit 1
mkdir -p "$root/.git/hooks"
cp "$root/hooks/pre-commit" "$root/.git/hooks/pre-commit"
chmod +x "$root/.git/hooks/pre-commit" "$root/hooks/bump_sequence.py" 2>/dev/null || true
echo "Installed .git/hooks/pre-commit"
